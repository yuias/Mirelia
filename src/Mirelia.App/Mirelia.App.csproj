<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Mirelia-icon-256.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Shown verbatim in the About dialog, so the notices travel with the
         binary rather than depending on a file next to it. -->
    <AvaloniaResource Include="..\..\THIRD-PARTY-NOTICES.md"
                      Link="Assets\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mirelia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mirelia.Library\Mirelia.Library.csproj" />
    <ProjectReference Include="..\Mirelia.Query\Mirelia.Query.csproj" />
    <ProjectReference Include="..\Mirelia.AudioBridge\Mirelia.AudioBridge.csproj" />
    <ProjectReference Include="..\Mirelia.Sync.Mtp\Mirelia.Sync.Mtp.csproj" />
  </ItemGroup>

</Project>
