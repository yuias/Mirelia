<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mirelia.App.Dialogs.AboutDialog"
        Title="About Mirelia"
        Icon="avares://Mirelia.App/Assets/Mirelia-icon-256.png"
        Width="420" SizeToContent="Height"
        MaxHeight="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="16">
      <!-- The 256px asset is the only raster we ship; ask for a quality
           downscale so the mark stays clean at this size. -->
      <Image Source="avares://Mirelia.App/Assets/Mirelia-icon-256.png"
             Width="64" Height="64" VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />

      <StackPanel Spacing="4" VerticalAlignment="Center">
        <TextBlock x:Name="NameText" FontSize="22" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Opacity="0.7" />
        <!-- Absent when the build had no git checkout to read. -->
        <TextBlock x:Name="GitHashText" Opacity="0.5" FontSize="12"
                   FontFamily="Consolas,Menlo,monospace" IsVisible="False" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="Mirelia is released under the MIT License."
               Opacity="0.7" TextWrapping="Wrap" />

    <Expander Header="Third-party notices">
      <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock x:Name="NoticesText"
                             FontSize="12" TextWrapping="Wrap" />
      </ScrollViewer>
    </Expander>

    <StackPanel Spacing="4">
      <TextBlock Text="Log file" Opacity="0.7" />
      <!-- Selectable so it can be pasted into a bug report; absent when the
           log could not be opened. -->
      <SelectableTextBlock x:Name="LogPathText" FontSize="12"
                           TextWrapping="Wrap" Opacity="0.5" />
    </StackPanel>

    <Button Content="Close" Classes="accent" HorizontalAlignment="Right"
            Click="OnClose" IsDefault="True" IsCancel="True" />
  </StackPanel>
</Window>
