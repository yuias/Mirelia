<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mirelia.App.Dialogs.PreferencesDialog"
        Title="Preferences"
        Icon="avares://Mirelia.App/Assets/Mirelia-icon-256.png"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">

    <TabControl>
      <TabItem Header="Playback">
        <StackPanel Margin="0,12,0,0" Spacing="12">
          <TextBlock FontWeight="SemiBold" Text="Audio Output" />
          <StackPanel Spacing="6">
            <TextBlock Text="Device" Opacity="0.7" FontSize="12" />
            <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" />
            <CheckBox x:Name="ExclusiveCheck"
                      Content="Exclusive mode (bit-perfect, blocks other apps)" />
          </StackPanel>

          <TextBlock FontWeight="SemiBold" Text="ReplayGain" />
          <StackPanel Spacing="6">
            <ComboBox x:Name="RgBox" HorizontalAlignment="Stretch" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="Applies scanned track gain during playback. Scan your library from Tools → Scan ReplayGain." />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="Appearance">
        <StackPanel Margin="0,12,0,0" Spacing="12">
          <TextBlock FontWeight="SemiBold" Text="Theme" />
          <StackPanel Spacing="6">
            <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="Auto follows the Windows light/dark setting. Takes effect immediately." />
          </StackPanel>

          <TextBlock FontWeight="SemiBold" Text="Font" />
          <StackPanel Spacing="6">
            <TextBlock Text="Family" Opacity="0.7" FontSize="12" />
            <ComboBox x:Name="FontFamilyBox" HorizontalAlignment="Stretch" />
            <TextBlock Text="Size" Opacity="0.7" FontSize="12" />
            <NumericUpDown x:Name="FontSizeBox" HorizontalAlignment="Stretch"
                            Minimum="10" Maximum="20" Increment="1"
                            FormatString="0" />
            <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       Text="Applies app-wide, including the track grid. Takes effect immediately." />
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Save" Classes="accent" Click="OnSave" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
