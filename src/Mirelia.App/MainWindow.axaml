<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mirelia.App.ViewModels"
        xmlns:m="using:Mirelia.App.Models"
        xmlns:local="using:Mirelia.App"
        xmlns:pl="using:Mirelia.Library.Playlists"
        x:Class="Mirelia.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Mirelia"
        Width="1280" Height="760"
        DragDrop.AllowDrop="True">

  <Window.Styles>
    <!-- Grouped-layout track rows. The flat grid gets banding and a hover
         cue from the DataGrid's own row template; these rows are plain
         panels, so they carry their own. -->
    <Style Selector="Grid.trackrow">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Grid.trackrow.alt">
      <Setter Property="Background" Value="#0C808080" />
    </Style>
    <Style Selector="Grid.trackrow:pointerover">
      <Setter Property="Background" Value="#1C808080" />
    </Style>
    <!-- Last, so a selected row keeps reading as selected under the pointer. -->
    <Style Selector="Grid.trackrow.selected">
      <Setter Property="Background" Value="#38808080" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="Open Library…" Click="OnOpenLibraryClick"
                  ToolTip.Tip="Switch to another Mirelia library file" />
        <Separator />
        <MenuItem Header="Add Folder…" Click="OnAddFolderClick" />
        <MenuItem Header="Rescan Library" Click="OnRescanClick"
                  ToolTip.Tip="Re-reads tags of every file in all scanned folders" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClick" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="Scan ReplayGain" Click="OnRgScanClick" />
        <MenuItem Header="Sync…" Click="OnSyncClick" />
        <Separator />
        <MenuItem Header="Preferences…" Click="OnPreferencesClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <!-- MenuItem.IsChecked binds OneWay by default (unlike ToggleButton),
             so the toggle needs TwoWay to reach the view-model. -->
        <MenuItem Header="Queue" ToggleType="CheckBox"
                  IsChecked="{Binding Queue.IsOpen, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="Columns">
          <!-- Per-view reset lives in the grid's own context menu; this one
               is the "everywhere" hammer. -->
          <MenuItem Header="Reset in All Views" Click="OnResetAllColumnsClick"
                    ToolTip.Tip="Clears the saved column layout of every source and playlist" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About Mirelia" Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- Toolbar: search + sort -->
    <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <ComboBox DockPanel.Dock="Right" Width="170" Margin="8,0,0,0"
                  ItemsSource="{Binding AvailableSorts}"
                  SelectedItem="{Binding SelectedSort}" />
        <ComboBox DockPanel.Dock="Right" Width="110" Margin="8,0,0,0"
                  ItemsSource="{Binding AvailableLayouts}"
                  SelectedItem="{Binding SelectedLayout}"
                  ToolTip.Tip="Layout style — grouped layouts sort by group and have no column headers" />
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,4"
                IsVisible="{Binding CanPromoteSearch}"
                Click="OnSaveSearchAsPlaylistClick"
                ToolTip.Tip="Save query as smart playlist…">
          <PathIcon Width="11" Height="11"
                    Data="M3,4 H21 V6.5 H3 Z M3,10.5 H21 V13 H3 Z M3,17 H11 V19.5 H3 Z M16,14 H18.5 V17 H21.5 V19.5 H18.5 V22.5 H16 V19.5 H13 V17 H16 Z" />
        </Button>
        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="7,4"
                IsVisible="{Binding CanPromoteSearch}"
                Click="OnPinSearchAsTemporaryClick"
                ToolTip.Tip="Pin as temporary playlist (until Mirelia exits)">
          <PathIcon Width="11" Height="11"
                    Data="M4,3 H20 V5 H4 Z M4,19 H20 V21 H4 Z M5,5 H19 L12,12 Z M5,19 H19 L12,12 Z" />
        </Button>
        <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0" Padding="7,3"
                      FontSize="11" Content="DSL"
                      IsChecked="{Binding IsDslSearch}"
                      ToolTip.Tip="Toggle raw query mode (smart-playlist DSL)" />
        <TextBox PlaceholderText="{Binding SearchPlaceholder}"
                 Text="{Binding SearchText}" />
      </DockPanel>
    </Border>

    <!-- Transport bar. Icons are inline path geometry: monochrome, no
         emoji, themed via the button foreground. -->
    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,12,Auto,8,*,8,Auto,12,Auto,4,120"
            DataContext="{Binding Transport}">
        <Button Grid.Column="0" Width="36" Height="30"
                Command="{Binding PreviousCommand}" ToolTip.Tip="Previous">
          <PathIcon Width="12" Height="12"
                    Data="M4,4 H6.5 V20 H4 Z M20,4 V20 L7.5,12 Z" />
        </Button>
        <Button Grid.Column="1" Width="44" Height="30" Margin="4,0"
                Command="{Binding PlayPauseCommand}" ToolTip.Tip="Play / Pause">
          <Panel>
            <PathIcon Width="13" Height="13" IsVisible="{Binding !IsPlaying}"
                      Data="M6,4 L20,12 6,20 Z" />
            <PathIcon Width="13" Height="13" IsVisible="{Binding IsPlaying}"
                      Data="M5,4 H9.5 V20 H5 Z M14.5,4 H19 V20 H14.5 Z" />
          </Panel>
        </Button>
        <Button Grid.Column="2" Width="36" Height="30"
                Command="{Binding NextCommand}" ToolTip.Tip="Next">
          <PathIcon Width="12" Height="12"
                    Data="M17.5,4 H20 V20 H17.5 Z M4,4 L16.5,12 4,20 Z" />
        </Button>
        <TextBlock Grid.Column="4" VerticalAlignment="Center"
                   Text="{Binding PositionText}" />
        <Slider Grid.Column="6" VerticalAlignment="Center"
                Minimum="0" Maximum="{Binding TotalSeconds}"
                Value="{Binding PositionSeconds}" />
        <TextBlock Grid.Column="8" VerticalAlignment="Center"
                   Text="{Binding TotalText}" />
        <PathIcon Grid.Column="10" Width="14" Height="14" Opacity="0.7"
                  Data="M3,9 V15 H7.5 L13,20 V4 L7.5,9 Z M15.5,8.5 A5,5 0 0 1 15.5,15.5 L14.4,14.4 A3.5,3.5 0 0 0 14.4,9.6 Z" />
        <Slider Grid.Column="12" VerticalAlignment="Center"
                Minimum="0" Maximum="1"
                Value="{Binding Volume}" />
      </Grid>
    </Border>

    <!-- Status line -->
    <Border DockPanel.Dock="Bottom" Padding="10,2">
      <TextBlock Opacity="0.7" Text="{Binding StatusText}" />
    </Border>

    <!-- Main area: sources | tracks | queue, split by draggable separators.
         Pane widths live on the columns (persisted in settings); the queue
         column collapses to zero when its pane is hidden — see
         MainWindow.ApplyQueuePaneWidth. -->
    <Grid x:Name="PanesGrid">
      <Grid.ColumnDefinitions>
        <!-- Column order is mirrored by MainWindow.LeftPaneColumn /
             QueuePaneColumn; keep them in step. -->
        <ColumnDefinition Width="220" MinWidth="150" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="0" />
      </Grid.ColumnDefinitions>

      <!-- Sources + playlists + now playing -->
      <Border Grid.Column="0" BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Margin="12,10,0,6" Opacity="0.6"
                     FontSize="12" Text="SOURCES" />
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Sources}"
                   SelectedItem="{Binding SelectedSource}" />
          <DockPanel Grid.Row="2" Margin="12,14,8,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <Button Padding="6,3" Click="OnNewPlaylistClick" ToolTip.Tip="New playlist…">
                <PathIcon Width="11" Height="11"
                          Data="M3,4 H21 V6.5 H3 Z M3,10.5 H21 V13 H3 Z M3,17 H11 V19.5 H3 Z M16,14 H18.5 V17 H21.5 V19.5 H18.5 V22.5 H16 V19.5 H13 V17 H16 Z" />
              </Button>
              <Button Padding="6,3" Click="OnNewFolderClick" ToolTip.Tip="New folder…">
                <PathIcon Width="11" Height="11"
                          Data="M2,5 H9 L11,7 H22 V19 H2 Z M14,10 H16.5 V12.5 H19 V15 H16.5 V17.5 H14 V15 H11.5 V12.5 H14 Z" />
              </Button>
            </StackPanel>
            <TextBlock Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                       Text="PLAYLISTS" />
          </DockPanel>
          <TreeView Grid.Row="3" x:Name="PlaylistTreeView"
                    ItemsSource="{Binding PlaylistTree}"
                    SelectedItem="{Binding SelectedNode}"
                    DragDrop.AllowDrop="True">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="True" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}"
                                x:DataType="vm:PlaylistNode">
                <StackPanel Orientation="Horizontal" Spacing="6"
                            Background="Transparent">
                  <PathIcon Width="11" Height="11" Opacity="0.55"
                            IsVisible="{Binding IsFolder}"
                            Data="M2,5 H9 L11,7 H22 V19 H2 Z" />
                  <PathIcon Width="11" Height="11" Opacity="0.55"
                            IsVisible="{Binding IsPlaylist}"
                            Data="M3,4 H21 V6.5 H3 Z M3,10.5 H21 V13 H3 Z M3,17 H13 V19.5 H3 Z" />
                  <TextBlock Text="{Binding Name}" FontStyle="{Binding NameStyle}"
                             ToolTip.Tip="{Binding Tooltip}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <!-- Now playing -->
          <Border Grid.Row="4" Padding="10" BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Spacing="8">
              <Border Height="198" CornerRadius="4" ClipToBounds="True"
                      Background="#14808080">
                <Panel>
                  <PathIcon Width="52" Height="52" Opacity="0.25"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M9,3 H20 V15.5 A3.5,3.5 0 1 1 17.5,12.1 V7 L11.5,8.2 V17.5 A3.5,3.5 0 1 1 9,14.1 Z" />
                  <Image Source="{Binding Transport.Artwork}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         Text="{Binding Transport.NowPlayingTitle}" />
              <TextBlock Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis"
                         Text="{Binding Transport.NowPlayingArtist}" />
              <TextBlock Opacity="0.5" FontSize="12" TextTrimming="CharacterEllipsis"
                         Text="{Binding Transport.NowPlayingAlbum}" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

      <!-- Playing-queue pane: MusicBee-style narrow "up next" list, drag to
           reorder, collapsible from the View menu. -->
      <GridSplitter Grid.Column="3" Width="4" Background="Transparent"
                    ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    IsVisible="{Binding Queue.IsOpen}" />
      <Border Grid.Column="4" BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
              IsVisible="{Binding Queue.IsOpen}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
            <Button DockPanel.Dock="Right" Padding="6,3" Click="OnClearQueueClick"
                    ToolTip.Tip="Clear queue (keeps the current track)">
              <PathIcon Width="10" Height="10" Data="M5,5 L19,19 M19,5 L5,19" />
            </Button>
            <TextBlock Opacity="0.6" FontSize="12" VerticalAlignment="Center" Text="QUEUE" />
          </DockPanel>
          <ListBox x:Name="QueueList"
                   ItemsSource="{Binding Queue.Rows}"
                   SelectionMode="Multiple"
                   DoubleTapped="OnQueueDoubleTapped"
                   KeyDown="OnQueueKeyDown"
                   DragDrop.AllowDrop="True">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:QueueRowViewModel">
                <Border Background="{Binding RowBrush}" Padding="8,4">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Artist}" Opacity="0.6" FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Play" Click="OnQueuePlayClick" />
                <MenuItem Header="Remove from Queue" Click="OnQueueRemoveClick" />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Track grid -->
      <Panel Grid.Column="2">
        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Tracks}"
                  IsVisible="{Binding IsFlatLayout}"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  Sorting="OnGridSorting"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#14808080"
                  RowHeight="26"
                  DoubleTapped="OnGridDoubleTapped"
                  DragDrop.AllowDrop="True">
          <DataGrid.ContextMenu>
            <ContextMenu Opened="OnGridMenuOpened">
              <MenuItem Header="Play" Click="OnPlaySelectedClick" />
              <MenuItem Header="Play Next" Click="OnPlayNextClick" />
              <MenuItem Header="Add to Queue" Click="OnAddToQueueClick" />
              <Separator />
              <MenuItem Header="Add to Playlist"
                        ItemsSource="{Binding StaticPlaylists}"
                        Click="OnAddToPlaylistClick">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="pl:PlaylistInfo">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
              </MenuItem>
              <Separator />
              <MenuItem x:Name="ColumnsMenu" Header="Columns" />
            </ContextMenu>
          </DataGrid.ContextMenu>
        </DataGrid>
        <!-- Grouped layout: one block per album/artist, cover on the left.
             Its own ScrollViewer template is what lets the panel virtualize;
             an ItemsControl has none of its own. -->
        <ItemsControl x:Name="BlockList"
                      ItemsSource="{Binding GroupedTracks}"
                      IsVisible="{Binding !IsFlatLayout}"
                      ContainerPrepared="OnBlockPrepared">
          <ItemsControl.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Play" Click="OnPlaySelectedClick" />
              <MenuItem Header="Play Next" Click="OnPlayNextClick" />
              <MenuItem Header="Add to Queue" Click="OnAddToQueueClick" />
              <Separator />
              <MenuItem Header="Add to Playlist"
                        ItemsSource="{Binding StaticPlaylists}"
                        Click="OnAddToPlaylistClick">
                <MenuItem.ItemTemplate>
                  <DataTemplate x:DataType="pl:PlaylistInfo">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </MenuItem.ItemTemplate>
              </MenuItem>
            </ContextMenu>
          </ItemsControl.ContextMenu>
          <ItemsControl.Template>
            <ControlTemplate>
              <ScrollViewer>
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:TrackGroupBlock">
              <Grid ColumnDefinitions="Auto,*" Margin="14,12,14,20">
                <Border Grid.Column="0" Width="210" Height="210" Margin="0,0,18,0"
                        VerticalAlignment="Top" CornerRadius="3"
                        ClipToBounds="True" Background="#14808080">
                  <Panel>
                    <PathIcon Width="56" Height="56" Opacity="0.22"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M9,3 H20 V15.5 A3.5,3.5 0 1 1 17.5,12.1 V7 L11.5,8.2 V17.5 A3.5,3.5 0 1 1 9,14.1 Z" />
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                  </Panel>
                </Border>

                <StackPanel Grid.Column="1">
                  <DockPanel Background="Transparent"
                             PointerPressed="OnBlockHeaderPressed"
                             DoubleTapped="OnBlockHeaderDoubleTapped"
                             ToolTip.Tip="Click to select the whole group, double-click to play it">
                    <TextBlock DockPanel.Dock="Right" Opacity="0.55" FontSize="12"
                               VerticalAlignment="Bottom" Margin="12,0,0,3"
                               Text="{Binding DurationText}" />
                    <StackPanel Spacing="2">
                      <TextBlock FontSize="16" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Title}" />
                      <TextBlock Opacity="0.55" FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Subtitle}" />
                    </StackPanel>
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding Discs}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="m:DiscSection">
                        <StackPanel>
                          <TextBlock Margin="10,6,0,4" Opacity="0.5" FontSize="11"
                                     FontStyle="Italic"
                                     IsVisible="{Binding HasCaption}"
                                     Text="{Binding Caption}" />
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="m:TrackRow">
                                <Grid Height="26" Classes="trackrow"
                                      Classes.alt="{Binding IsAlternate}"
                                      Classes.selected="{Binding IsSelected}"
                                      PointerPressed="OnBlockRowPressed"
                                      DoubleTapped="OnBlockRowDoubleTapped"
                                      ColumnDefinitions="40,*,Auto,58">
                                  <TextBlock Grid.Column="0" Opacity="0.5" FontSize="12"
                                             VerticalAlignment="Center"
                                             TextAlignment="Right" Margin="0,0,10,0"
                                             Text="{Binding TrackNo}" />
                                  <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                             TextTrimming="CharacterEllipsis"
                                             Text="{Binding Title}" />
                                  <ContentControl Grid.Column="2" Content="{Binding}"
                                                  ContentTemplate="{x:Static local:MainWindow.RatingCell}" />
                                  <TextBlock Grid.Column="3" Opacity="0.6" FontSize="12"
                                             VerticalAlignment="Center"
                                             TextAlignment="Right"
                                             Text="{Binding Duration}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8"
                    IsVisible="{Binding IsLibraryEmpty}">
          <TextBlock FontSize="18" Opacity="0.7" HorizontalAlignment="Center"
                     Text="Your library is empty" />
          <TextBlock Opacity="0.5" HorizontalAlignment="Center"
                     Text="Use “Add Folder…” to scan your music." />
        </StackPanel>
      </Panel>

    </Grid>

  </DockPanel>
</Window>
