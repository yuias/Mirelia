<Project Sdk="Microsoft.NET.Sdk">

  <!-- MTP destinations over the WPD COM API. Separate from Mirelia.Library so
       CsWin32, unsafe code and a Windows-only surface stay out of the core. -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mirelia.Library\Mirelia.Library.csproj" />
  </ItemGroup>

</Project>
