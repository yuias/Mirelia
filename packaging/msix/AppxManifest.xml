<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package manifest template for Mirelia.

  Placeholders are substituted at pack time by scripts/package-msix.cs:
    {{PACKAGE_NAME}}            - Store-issued Package Identity Name
    {{PUBLISHER}}               - Store-issued Publisher (X.500 DN, e.g. CN=<GUID>)
    {{VERSION}}                 - 4-part version (e.g. 0.1.0.0)
    {{PUBLISHER_DISPLAY_NAME}}  - Publisher display name registered in Partner Center
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="{{PACKAGE_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Mirelia</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Desktop music library and player</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    <!--
      The Rust audio backend imports VCRUNTIME140.dll. A packaged full-trust app
      cannot use the machine-wide Visual C++ redistributable, so the runtime has
      to come from the Desktop Bridge framework package instead; the Store
      installs it before first launch. MinVersion tracks the FrameworkIdentity
      MinVersion in the Windows SDK's Microsoft.VCLibs.Desktop manifest, so bump
      it when the MSVC toolchain moves.
    -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop"
                       MinVersion="14.0.33728.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Mirelia" Executable="Mirelia.App.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Mirelia"
        Description="Desktop music library and player"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\LargeTile.png"
          Square71x71Logo="Assets\SmallTile.png"
          ShortName="Mirelia" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="transparent" />
      </uap:VisualElements>
      <Extensions>
        <!--
          The MusicBee import and the other headless commands live in the CLI,
          which an installed package keeps under a directory users cannot browse
          into. The alias is what puts it on PATH, so without it the CLI would
          ship unreachable.
        -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="mirelia-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="mirelia-cli.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
