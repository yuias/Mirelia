root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true

[*.rs]
indent_size = 4
insert_final_newline = true
max_line_length = 100

[*.{toml,yaml,yml,json,xml}]
indent_size = 2

[*.cs]
indent_size = 4
insert_final_newline = true

[*.{cpp,c,h}]
indent_size = 4
insert_final_newline = true

[*.{cspro,slnx,props}]
end_of_line = lf
indent_size = 2
trim_trailing_whitespace = false

[*.{md,txt}]
trim_trailing_whitespace = false
